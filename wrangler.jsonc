// Cloudflare Worker for the site. Static pages are served from ./dist as assets; only the
// on-demand routes (form action, /api/telegram) run the Worker. Secrets: dashboard → Settings →
// Variables and Secrets (names in .env.example).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mavpy-site",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-26",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "binding": "ASSETS", "directory": "./dist" },
  "observability": { "enabled": true },
}
