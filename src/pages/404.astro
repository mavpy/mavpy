---
// One 404 for every missing URL (the host serves this file for /uk/... too), so it carries both
// languages: English first, then the Ukrainian block in its own lang. Big "404" reuses the hero
// "MORE" style (BBH Hegarty); noindex keeps it out of search results.
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
import Container from '../components/ui/Container.astro';
import { localizePath, t } from '../i18n/utils';

const en = t('en').notFound;
const uk = t('uk').notFound;
---

<Base title={`404: ${en.title} | MAVPY`} noindex>
  <Container class="flex flex-col items-center pt-[60px] pb-[120px] text-center lg:pt-[100px] lg:pb-[180px]">
    <p aria-hidden="true" class="rise font-hegarty text-more leading-[0.7]">
      404
    </p>
    <h1
      style="--d: 0.1s"
      class="rise mt-[48px] font-display text-h2 font-extrabold max-lg:tracking-[-0.03em]"
    >
      {en.title}
    </h1>
    <p style="--d: 0.2s" class="rise mt-[20px]">
      {en.text}
    </p>
    <Button href={localizePath('en')} class="rise mt-[40px]" style="--d: 0.3s">
      {en.cta}
    </Button>

    <div
      lang="uk"
      style="--d: 0.4s"
      class="rise mt-[64px] border-t border-grey-light pt-[32px]"
    >
      <p class="text-card font-bold">{uk.title}</p>
      <p class="mt-[12px]">
        {uk.text}{' '}
        <a
          href={localizePath('uk')}
          class="font-medium underline underline-offset-2"
        >
          {uk.cta}
        </a>
      </p>
    </div>
  </Container>
</Base>
