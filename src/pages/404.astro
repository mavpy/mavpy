---
// One 404 for every missing URL (the host serves this file for /en/... too), so it carries both
// languages: Ukrainian (the default) first, then the English block in its own lang. Big "404" reuses
// BBH Hegarty, as the hero's «MORE»; noindex keeps it out of search results.
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
import Container from '../components/ui/Container.astro';
import { localizePath, t } from '../i18n/utils';

const uk = t('uk').notFound;
const en = t('en').notFound;
---

<Base title={`404: ${uk.title} | MAVPY`} noindex>
  <Container class="flex flex-col items-center py-[max(80px,calc(140*var(--u)))] text-center">
    <p aria-hidden="true" class="font-hegarty text-[max(96px,calc(200*var(--u)))] leading-[0.7] text-black motion-safe:animate-rise-in">
      404
    </p>
    <h1 class="mt-[48px] font-head text-h2 leading-none font-bold tracking-[-0.02em] text-black [--d:0.1s] motion-safe:animate-rise-in">
      {uk.title}
    </h1>
    <p class="mt-[20px] text-lead text-text-2 [--d:0.2s] motion-safe:animate-rise-in">{uk.text}</p>
    <Button href={localizePath('uk')} class="mt-[40px] [--d:0.3s] motion-safe:animate-rise-in">
      {uk.cta}
    </Button>

    <div
      lang="en"
      class="mt-[64px] border-t border-line pt-[32px] [--d:0.4s] motion-safe:animate-rise-in"
    >
      <p class="font-head text-h3 font-bold text-black">{en.title}</p>
      <p class="mt-[12px]">
        {en.text}{' '}
        <a
          href={localizePath('en')}
          class="font-medium underline underline-offset-2"
        >
          {en.cta}
        </a>
      </p>
    </div>
  </Container>
</Base>
