---
// One 404 for every missing URL (the host serves this file for /en/... too), so it carries both
// languages: Ukrainian (the default) first, then the English block in its own lang. Big "404" reuses
// the hero "MORE" style (BBH Hegarty); noindex keeps it out of search results.
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
import Container from '../components/ui/Container.astro';
import { localizePath, t } from '../i18n/utils';

const uk = t('uk').notFound;
const en = t('en').notFound;
---

<Base title={`404: ${uk.title} | MAVPY`} noindex>
  <Container class="flex flex-col items-center pt-[60px] pb-[120px] text-center lg:pt-[100px] lg:pb-[180px]">
    <p aria-hidden="true" class="rise font-hegarty text-more leading-[0.7]">
      404
    </p>
    <h1 class="rise mt-[48px] font-display text-h2 font-extrabold [--d:0.1s] max-lg:tracking-[-0.03em]">
      {uk.title}
    </h1>
    <p class="rise mt-[20px] [--d:0.2s]">{uk.text}</p>
    <Button href={localizePath('uk')} class="rise mt-[40px] [--d:0.3s]">
      {uk.cta}
    </Button>

    <div
      lang="en"
      class="rise mt-[64px] border-t border-grey-light pt-[32px] [--d:0.4s]"
    >
      <p class="text-card font-bold">{en.title}</p>
      <p class="mt-[12px]">
        {en.text}{' '}
        <a
          href={localizePath('en')}
          class="font-medium underline underline-offset-2"
        >
          {en.cta}
        </a>
      </p>
    </div>
  </Container>
</Base>
