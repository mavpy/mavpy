---
import '../styles/global.css';
import Header from '../components/sections/Header.astro';
import Footer from '../components/sections/Footer.astro';
import { getLang, langs, localizePath, t } from '../i18n/utils';
// Hero fonts are only discovered through the CSS, so preload the ones that swap visibly above the
// fold. `?url` resolves to the same hashed file the Fontsource CSS points at.
import hegartyLatin from '@fontsource/bbh-hegarty/files/bbh-hegarty-latin-400-normal.woff2?url';
import robotoLatin500 from '@fontsource/roboto/files/roboto-latin-500-normal.woff2?url';
import robotoCyr400 from '@fontsource/roboto/files/roboto-cyrillic-400-normal.woff2?url';
import robotoCyr500 from '@fontsource/roboto/files/roboto-cyrillic-500-normal.woff2?url';

const lang = getLang(Astro.url);
const { meta, a11y } = t(lang);
const site = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, site).href;
const ogLocale = { en: 'en_US', uk: 'uk_UA' } as const;
// Helvetica Thin is "clients" (the LCP) on both pages. On /uk/ "БІЛЬШЕ" falls back to Roboto (no Cyrillic in Hegarty).
const preloadFonts = [
  '/fonts/HelveticaNeue-Thin.woff2',
  ...(lang === 'uk'
    ? [robotoCyr400, robotoCyr500]
    : [hegartyLatin, robotoLatin500]),
];
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    {preloadFonts.map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={canonical} />
    {langs.map((l) => (
      <link
        rel="alternate"
        hreflang={l}
        href={new URL(localizePath(l), site).href}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localizePath('en'), site).href}
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MAVPY" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {langs
      .filter((l) => l !== lang)
      .map((l) => (
        <meta property="og:locale:alternate" content={ogLocale[l]} />
      ))}
    <!-- og:image + twitter card come in M7, once the OG image is cropped. -->

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon-dark.svg"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-btn focus:bg-white focus:px-4 focus:py-2 focus:text-nav"
    >
      {a11y.skipToContent}
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
