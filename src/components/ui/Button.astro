---
import type { HTMLAttributes } from 'astro/types';

// btn_main from the UI kit (styles and states follow the Webflow build).
// lg: hero and form (Roboto Medium 23, 58px tall). sm: pricing cards (16px, about 41px tall).
// Renders an <a> when href is given, otherwise a <button>.
type Props = {
  size?: 'lg' | 'sm';
  /** telegram: Telegram's brand blue with white text (the bot link). */
  tone?: 'orange' | 'telegram';
  /** Full width (used on mobile). Pass responsive classes via `class` to undo it on desktop. */
  block?: boolean;
  class?: string;
} & (HTMLAttributes<'a'> | HTMLAttributes<'button'>);

// `type` is pulled out: spreading it after a default would render the attribute twice (first wins).
const {
  size = 'lg',
  tone = 'orange',
  block = false,
  class: className,
  type,
  ...rest
} = Astro.props;
const sizes = {
  lg: 'text-btn px-[38px] py-[15.5px]',
  sm: 'text-btn-sm px-[18px] py-[11px]',
};
const tones = {
  orange:
    'bg-orange text-black hover:bg-orange-300 active:bg-orange-700 disabled:bg-orange-200',
  // Deeper than Telegram's #2AABEE: white on that is 2.6:1; #0077B5 is 4.9:1 (AA).
  telegram: 'bg-[#0077B5] text-white hover:bg-[#006DAD] active:bg-[#005F96]',
};
const classes = [
  'inline-flex items-center justify-center gap-2 rounded-btn text-center font-medium shadow-btn',
  'transition-colors duration-300',
  'disabled:cursor-not-allowed disabled:shadow-none aria-busy:cursor-wait',
  tones[tone],
  sizes[size],
  block && 'w-full',
  className,
];
---

{/* Two explicit branches rather than a dynamic <Tag>: TS can't type `type` on an a|button union. */}
{'href' in rest && rest.href ? (
  <a {...(rest as HTMLAttributes<'a'>)} type={type} class:list={classes}>
    <slot />
  </a>
) : (
  <button
    {...(rest as HTMLAttributes<'button'>)}
    type={(type as HTMLAttributes<'button'>['type']) ?? 'button'}
    class:list={classes}
  >
    <slot />
  </button>
)}
