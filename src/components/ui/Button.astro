---
import type { HTMLAttributes } from 'astro/types';

// btn_main from the design (.mv-btn, v3.15): amber, Roboto Medium; on hover it lifts and grows a
// little with a soft amber glow, the text colour never changes. lg: hero, forms, menu. sm: header.
// Renders an <a> when href is given, otherwise a <button>.
type Props = {
  size?: 'lg' | 'sm';
  /** soft: pale amber with an amber outline (secondary). telegram: Telegram's blue (the bot link).
   *  outline: white text in a thin amber ring, for dark sections (cases). */
  tone?: 'amber' | 'soft' | 'telegram' | 'outline';
  /** Full width. Pass responsive classes via `class` to undo it on wider screens. */
  block?: boolean;
  class?: string;
} & (HTMLAttributes<'a'> | HTMLAttributes<'button'>);

// `type` is pulled out: spreading it after a default would render the attribute twice (first wins).
const {
  size = 'lg',
  tone = 'amber',
  block = false,
  class: className,
  type,
  ...rest
} = Astro.props;
const sizes = {
  lg: 'h-[max(48px,calc(58*var(--u)))] text-[max(16px,calc(23*var(--u)))]',
  sm: 'h-[max(40px,calc(48*var(--u)))] text-[max(14px,calc(18*var(--u)))]',
};
const tones = {
  amber:
    'bg-amber-500 text-black hover:bg-[#ffb829] focus-visible:bg-[#ffb829] disabled:bg-amber-300',
  soft: 'bg-[#fff6e3] text-black inset-ring-[1.5px] inset-ring-amber-500 hover:bg-[#ffefcf] focus-visible:bg-[#ffb829] active:bg-amber-500',
  // Deeper than Telegram's #2AABEE: white on that is 2.6:1; #0077B5 is 4.9:1 (AA).
  telegram: 'bg-[#0077B5] text-snow hover:bg-[#006DAD]',
  outline:
    'text-snow inset-ring inset-ring-amber-500 hover:bg-amber-500/12 focus-visible:bg-[#ffb829] focus-visible:text-black active:bg-amber-500 active:text-black',
};
const classes = [
  'group/btn inline-flex shrink-0 cursor-pointer items-center justify-center gap-3 rounded-btn px-[max(20px,calc(28*var(--u)))] text-center font-medium whitespace-nowrap',
  'transition-[background-color,translate,scale,box-shadow] duration-250 ease-mv',
  'hover:-translate-y-px hover:scale-[1.03] hover:shadow-btn-hover focus-visible:-translate-y-px focus-visible:scale-[1.03] focus-visible:shadow-btn-hover',
  'active:translate-y-0 active:shadow-none',
  'disabled:pointer-events-none aria-busy:cursor-wait',
  tones[tone],
  sizes[size],
  block && 'w-full',
  className,
];
---

{/* Two explicit branches rather than a dynamic <Tag>: TS can't type `type` on an a|button union. */}
{'href' in rest && rest.href ? (
  <a {...(rest as HTMLAttributes<'a'>)} type={type} class:list={classes}>
    <slot />
  </a>
) : (
  <button
    {...(rest as HTMLAttributes<'button'>)}
    type={(type as HTMLAttributes<'button'>['type']) ?? 'button'}
    class:list={classes}
  >
    <slot />
  </button>
)}
