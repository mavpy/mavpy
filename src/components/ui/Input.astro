---
import type { HTMLAttributes } from 'astro/types';

// Labelled form field, the design's .v-field: small label above a framed 17px input; focus
// turns the frame amber with a soft amber ring (instead of the global focus ring).
// A `prefix` slot sits before the control on the same row (the phone country code); give it the
// exported `frame` classes so it matches. The error line takes no space while empty (it cancels the 8px gap), as the design reserves none.
type Props = {
  label: string;
  name: string;
  /** Inline error (from client or server validation). */
  error?: string;
  class?: string;
} & HTMLAttributes<'input'>;

const { label, name, error, class: className, ...rest } = Astro.props;
const id = rest.id ?? `field-${name}`;
const errorId = `${id}-error`;
---

<div class:list={['flex flex-col gap-[8px]', className]}>
  <label for={id} class="text-[15px] font-medium text-text-2">
    {label}
  </label>
  <div class:list={[Astro.slots.has('prefix') && 'flex gap-[8px]']}>
    <slot name="prefix" />
    <input
      {...rest}
      id={id}
      name={name}
      aria-invalid={error ? 'true' : undefined}
      aria-describedby={error ? errorId : undefined}
      class="frame w-full min-w-0 px-[16px] placeholder:text-[#9a968f] aria-invalid:border-error"
    />
  </div>
  <p
    id={errorId}
    class="text-[14px] text-error empty:-mt-[8px]"
    aria-live="polite"
  >
    {error}
  </p>
</div>
