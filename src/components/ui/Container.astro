---
// The 1226px content column, with a 24px gutter below that width.
interface Props {
  as?: 'div' | 'header' | 'footer' | 'nav';
  class?: string;
}
const { as: Tag = 'div', class: className } = Astro.props;
---

<Tag
  class:list={[
    'mx-auto w-[calc(100%-2*var(--spacing-gutter))] max-w-content',
    className,
  ]}
>
  <slot />
</Tag>
