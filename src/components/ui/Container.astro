---
// The design's page column: 1280 units on desktop (scales with --u), 20px gutters below 1200px.
// Since v3.3 the hero and every section share this one width.
interface Props {
  as?: 'div' | 'header' | 'footer' | 'nav';
  class?: string;
}
const { as: Tag = 'div', class: className } = Astro.props;
---

<Tag class:list={['mx-auto w-[calc(100%-40px)] desk:w-site', className]}>
  <slot />
</Tag>
