---
// Sticky header (design .mv-head). Its height never changes; once the page scrolls it gets a
// translucent warm background with blur. Desktop (1200+): nav, UA / EN, small CTA. Below that: logo +
// burger. The menu is a native popover (Esc, outside click and focus return come free), dropped
// under the header like the design's .mv-mnav.
import Logo from '../../assets/v3/logo-dark.svg';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import LangSwitch from '../ui/LangSwitch.astro';
import { getLang, localizePath, navLinks, t } from '../../i18n/utils';

const lang = getLang(Astro.url);
const { nav } = t(lang);
const home = localizePath(lang, '#top');
// «Find out the cost» goes to the prices, same as the hero CTA (2026-11-28).
const cost = localizePath(lang, '#pricing');
const link =
  'uppercase text-black transition-colors hover:text-amber-700 text-[max(13px,calc(18*var(--u)))] max-tab:text-[14px] font-medium';
const bar =
  'absolute left-0 h-[1.6px] w-full bg-black transition-[top,rotate] duration-250 ease-mv';
---

<header
  data-head
  class="sticky top-0 z-60 border-b border-black/[0.045] transition-colors duration-300 ease-mv data-stuck:bg-warm-50/94 data-stuck:backdrop-blur-[8px]"
>
  <Container class="flex h-head items-center justify-between">
    <a href={home} aria-label={nav.home} class="flex items-center">
      <Logo aria-hidden="true" class="h-[max(30px,calc(44*var(--u)))] w-auto" />
    </a>

    <nav
      aria-label={nav.label}
      class="hidden items-center gap-[max(24px,calc(48*var(--u)))] desk:flex"
    >
      {navLinks.map(([id, key]) => (
        <a href={localizePath(lang, `#${id}`)} class={link}>
          {nav[key]}
        </a>
      ))}
      <LangSwitch />
      <Button href={cost} size="sm">
        {nav.cta}
      </Button>
    </nav>

    <button
      type="button"
      popovertarget="mobile-menu"
      aria-label={nav.menuOpen}
      class="inline-flex size-11 items-center justify-center rounded-btn border-[1.5px] border-black desk:hidden"
    >
      <span aria-hidden="true" class="relative h-3 w-[18px]">
        <i
          class:list={[bar, 'top-px menu-open:top-[5px] menu-open:rotate-45']}
        ></i>
        <i
          class:list={[
            bar,
            'top-[9px] menu-open:top-[5px] menu-open:-rotate-45',
          ]}
        ></i>
      </span>
    </button>
  </Container>

  <nav
    id="mobile-menu"
    popover
    aria-label={nav.label}
    class="inset-x-0 top-head bottom-auto m-0 w-auto max-w-none gap-1 border-0 border-b border-line bg-warm-50 px-5 pt-2 pb-6 text-black shadow-[0_24px_32px_-24px_rgb(15_15_15/0.35)] open:grid desk:hidden"
  >
    {navLinks.map(([id, key]) => (
      <a
        href={localizePath(lang, `#${id}`)}
        data-menu-link
        class="py-3 text-lg font-medium uppercase transition-colors hover:text-amber-700"
      >
        {nav[key]}
      </a>
    ))}
    <div class="flex items-center justify-between gap-3 pt-2">
      <LangSwitch />
      <Button href={cost} data-menu-link>
        {nav.cta}
      </Button>
    </div>
  </nav>
</header>

<script>
  const head = document.querySelector<HTMLElement>('[data-head]')!;
  const menu = document.getElementById('mobile-menu')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');

  // Background once the page scrolls (the height stays the same, so nothing jumps).
  const stuck = () => head.toggleAttribute('data-stuck', scrollY > 24);
  stuck();
  addEventListener('scroll', stuck, { passive: true });

  menu
    .querySelectorAll('[data-menu-link]')
    .forEach((a) => a.addEventListener('click', () => menu.hidePopover()));

  // The page opens at the top, not where the browser last left it. A #section in the address
  // (language switch, a link from the 404) is honoured once, then dropped from the URL.
  history.scrollRestoration = 'manual';
  const target =
    location.hash && document.getElementById(location.hash.slice(1));
  if (location.hash) history.replaceState(null, '', location.pathname);
  if (target) target.scrollIntoView();
  else scrollTo(0, 0);

  // In-page links scroll to their section without writing #anchor into the address.
  document.addEventListener('click', (e) => {
    const a = (e.target as Element).closest<HTMLAnchorElement>('a[href*="#"]');
    if (!a || a.pathname !== location.pathname || e.metaKey || e.ctrlKey)
      return;
    const id = a.hash.slice(1);
    const el = id === 'top' ? null : document.getElementById(id);
    if (id !== 'top' && !el) return;
    e.preventDefault();
    const behavior = reduce.matches ? 'auto' : 'smooth';
    if (el) el.scrollIntoView({ behavior });
    else scrollTo({ top: 0, behavior });
  });

  // Language switch: remember the choice for the next visit to / (see Base.astro) and keep the
  // reader's place by carrying over the section in view.
  document
    .querySelectorAll<HTMLAnchorElement>('[data-lang-switch]')
    .forEach((a) =>
      a.addEventListener('click', () => {
        try {
          localStorage.setItem('mavpy-lang', a.dataset.langSwitch!);
        } catch {}
        const current = [...document.querySelectorAll('main section[id]')]
          .filter((s) => s.getBoundingClientRect().top <= innerHeight / 3)
          .pop();
        a.hash = current && current.id !== 'top' ? current.id : '';
      }),
    );
</script>
