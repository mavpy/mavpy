---
// Pain points ("Which of these sounds like you right now?").
// Spacing is Figma's ink positions converted to CSS boxes with the font metrics
// (Archivo 800: ascent 0.878, descent 0.21; Roboto: ascent 0.928, cap 0.711).
// Cards are equal width on lg (Figma's 355/341/477 overruled by Nikita, 2026-11-19).
// On lg the cards are a subgrid, so the bodies line up even when a title wraps to 3 lines (uk).
import Card from '../ui/Card.astro';
import Heading from '../ui/Heading.astro';
import Section from '../ui/Section.astro';
import { getLang, t } from '../../i18n/utils';

const { pain } = t(getLang(Astro.url));
---

<Section
  id="situation"
  tone="sand"
  class="pt-[68px] pb-[89px] lg:pt-[124px] lg:pb-[82px]"
>
  <div class="lg:flex lg:items-start lg:justify-between">
    <Heading class="lg:max-w-[760px]">{pain.title}</Heading>
    <!-- Decorative section tag, desktop only (not in the mobile frame). -->
    <p aria-hidden="true" class="mt-[9px] max-lg:hidden">
      {pain.label}
      <span class="ml-[25px]">|</span>
    </p>
  </div>

  <p class="mt-[44px] text-center text-[21px] lg:mt-[35px] lg:text-left lg:text-body">
    {pain.sub}
  </p>

  <ul class="mt-[60px] grid gap-8 text-center lg:mt-[68px] lg:grid-cols-3 lg:gap-x-[26px] lg:gap-y-0 lg:text-left">
    {pain.cards.map(({ title, text }) => (
      <Card
        as="li"
        class="px-5 py-[17px] lg:row-span-2 lg:grid lg:grid-rows-subgrid lg:content-start lg:px-6.5 lg:pt-[21px] lg:pb-6.5"
      >
        <h3 class="text-card font-bold">
          {title[0]}
          <br class="max-lg:hidden" /> {title[1]}
        </h3>
        <!-- min-h on the body, not the card: a subgrid item can't grow its tracks. 148 = Figma's 367px card minus padding, 2-line title and gap. -->
        <p class="mt-[30px] lg:mt-[78px] lg:min-h-[148px] lg:leading-[28px]">
          {text}
        </p>
      </Card>
    ))}
  </ul>
</Section>
