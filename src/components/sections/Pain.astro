---
// Situation (design v3.15, section 02): head + three warm cards, each with a looping line icon
// (CSS in global.css, .pi). Icons go by card index, as in the design.
import Container from '../ui/Container.astro';
import SectionHead from '../ui/SectionHead.astro';
import { getLang, t } from '../../i18n/utils';

const { pain } = t(getLang(Astro.url));

const cells = [0, 1, 2]
  .flatMap((r) =>
    [0, 1, 2].map(
      (c) =>
        `<rect class="pi-cell" x="${14 + c * 13}" y="${30 + r * 9}" width="9" height="5" rx="1.2"/>`,
    ),
  )
  .join('');
const bars = [12, 25, 38, 51]
  .map(
    (x) =>
      `<rect class="pi-bar" x="${x}" y="20" width="7" height="36" rx="1.5"/>`,
  )
  .join('');
const icons = [
  // a line that keeps climbing
  '<path class="pi-ax" d="M8 56H58M8 56V8"/><path class="pi-grid" d="M8 41H58M8 26H58"/><path class="pi-ln" pathLength="1" d="M10 48 L22 40 L31 44 L43 28 L56 14"/><circle class="pi-dot" cx="56" cy="14" r="2.6"/>',
  // bars rising one by one
  `<path class="pi-ax" d="M8 56H58"/>${bars}`,
  // a week grid filling up cell by cell
  `<rect class="pi-ax" x="8" y="12" width="48" height="44" rx="4"/><path class="pi-ax" d="M8 24H56M20 8V16M44 8V16"/>${cells}`,
];
---

<section class="bg-snow py-[max(80px,calc(140*var(--u)))]">
  <Container>
    <SectionHead label={pain.label} title={pain.title} lead={pain.sub} />
    <ul class="grid gap-g desk:grid-cols-3">
      {pain.cards.map(({ title, text }, i) => (
        <li
          data-ri
          class="flex flex-col gap-[max(16px,calc(24*var(--u)))] rounded-[12px] border border-transparent bg-warm-50 p-[max(24px,calc(40*var(--u)))] hover:border-amber-500"
        >
          <svg
            class="pi"
            viewBox="0 0 64 64"
            aria-hidden="true"
            set:html={icons[i]}
          />
          <h3 class="font-head text-h3 leading-[1.05] font-bold tracking-[-0.005em] text-black">
            {title}
          </h3>
          <p class="text-body leading-[1.5] text-text-2">{text}</p>
        </li>
      ))}
    </ul>
  </Container>
</section>
