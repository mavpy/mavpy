---
// Cases (design v3.15, section 04): dark section, an accordion of case rows. Built on
// <details name>, so the browser handles "one open at a time", keyboard and ARIA state; the open
// animation (.case in global.css) needs `interpolate-size`, other browsers just snap open.
// Differences from the design: the whole row toggles (not just the round button); the first case
// is open from the start instead of opening when the block scrolls in; and the design's script that
// holds the clicked row still while a panel above collapses is left to native scroll anchoring
// (ponytail: Safari has no scroll anchoring, so the row can jump there; port the design's rAF hold
// if that matters).
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import SectionHead from '../ui/SectionHead.astro';
import { getLang, t } from '../../i18n/utils';

const { cases } = t(getLang(Astro.url));
const shots = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/v3/cases/*.jpg',
  {
    eager: true,
  },
);
const shot = (name: string) =>
  shots[`../../assets/v3/cases/${name}.jpg`].default;
---

<section
  id="cases"
  class="bg-[#2a2a2a] py-[max(80px,calc(140*var(--u)))] text-[#ededeb]"
>
  <Container wide>
    <SectionHead
      label={cases.label}
      title={cases.title}
      lead={cases.sub}
      dark
    />
    <div class="border-t border-white/16">
      {cases.items.map((c, i) => (
        <details
          data-ri
          name="cases"
          open={i === 0}
          class="case group border-b border-white/16"
        >
          <summary class="group/s relative grid cursor-pointer list-none items-center gap-[2px] py-[max(18px,calc(30*var(--u)))] max-desk:pr-[60px] desk:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] desk:gap-g desk:px-[max(16px,calc(24*var(--u)))] [&::-webkit-details-marker]:hidden">
            <span class="flex items-center gap-[14px] desk:gap-[max(16px,calc(40*var(--u)))]">
              <span class="font-mono text-[max(13px,calc(16*var(--u)))] font-medium text-[#9a9a96]">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="font-head text-[max(24px,calc(40*var(--u)))] leading-none font-bold tracking-[-0.01em] text-white">
                {c.name}
              </h3>
            </span>
            <span class="pl-[calc(2ch+14px)] text-[14px] text-[#c9c9c4] desk:pr-[64px] desk:pl-0 desk:text-[max(15px,calc(18*var(--u)))]">
              {c.kind}
            </span>
            <span
              aria-hidden="true"
              class="absolute top-1/2 right-0 flex size-[52px] -translate-y-1/2 items-center justify-center rounded-full border-[1.5px] border-white/50 text-white transition-colors duration-150 group-hover/s:border-amber-500 group-hover/s:bg-amber-500 group-hover/s:text-black"
            >
              <svg
                width="18"
                height="18"
                viewBox="0 0 18 18"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                class="transition-transform duration-300 ease-mv group-open:rotate-45"
              >
                <path d="M9 2v14M2 9h14" />
              </svg>
            </span>
          </summary>

          <div class="mb-[max(24px,calc(40*var(--u)))] grid items-stretch gap-g rounded-[16px] bg-[#363636] p-[14px] desk:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] desk:p-[max(16px,calc(24*var(--u)))]">
            <div class="overflow-hidden rounded-[12px] [--d:0.15s] group-open:motion-safe:animate-rise-in desk:relative desk:min-h-[calc(560*var(--u))]">
              <Image
                src={shot(c.shot)}
                alt={c.name}
                widths={[600, 1000, 1600]}
                sizes="(min-width: 1200px) 50vw, 100vw"
                class="block aspect-[16/10] w-full rounded-[10px] object-cover object-top desk:absolute desk:inset-0 desk:aspect-auto desk:h-full"
              />
            </div>
            <div class="flex flex-col gap-[max(22px,calc(30*var(--u)))]">
              <dl class="grid gap-[22px]">
                {cases.facts.map((dt, k) => (
                  <div>
                    <dt
                      class:list={[
                        'inline-block rounded-[4px] px-[10px] py-[4px] text-[max(13px,calc(15*var(--u)))] font-bold tracking-[0.02em] uppercase',
                        k === 2
                          ? 'bg-amber-500 text-black'
                          : 'bg-white/12 text-white',
                      ]}
                    >
                      {dt}
                    </dt>
                    <dd
                      class:list={[
                        'mt-[10px] text-body leading-[1.5] [&_b]:font-bold [&_b]:text-white',
                        k === 2 ? 'font-medium text-white' : 'text-[#ededeb]',
                      ]}
                      set:html={c.facts[k]}
                    />
                  </div>
                ))}
              </dl>
              <p class="mt-auto flex flex-wrap items-center gap-x-[16px] gap-y-[12px] pt-[max(24px,calc(32*var(--u)))]">
                <Button
                  href={c.url}
                  target="_blank"
                  rel="noopener"
                  tone="outline"
                  class="max-tab:w-full"
                >
                  {cases.live}
                  <span class="sr-only">: {c.name}</span>
                  <span
                    aria-hidden="true"
                    class="inline-block transition-transform duration-200 ease-mv group-hover/btn:translate-x-[5px]"
                  >
                    →
                  </span>
                </Button>
                <span class="font-mono text-[max(13px,calc(15*var(--u)))] text-[#9a9a96]">
                  {c.host}
                </span>
              </p>
            </div>
          </div>
        </details>
      ))}
    </div>
  </Container>
</section>
