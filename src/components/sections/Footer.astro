---
// Footer: dark band; logo + tagline (6fr), then Navigate / Contact / Studio (2fr
// each), stacked in one column below 1200px. A rule, the full-width wordmark, and the bottom bar.
// Contacts match the Contact section. Below the line over the wordmark: the hero grid, faint, full
// width; «Back to top» is a 52px round button sitting on that line (Serhii's option A, 2026-11-28).
import { Image } from 'astro:assets';
import Logo from '../../assets/v3/logo-light.svg';
import MailIcon from '../../assets/v3/icons/mail.svg';
import PhoneIcon from '../../assets/v3/icons/phone.svg';
import InstaIcon from '../../assets/v3/icons/insta.svg';
import TelegramIcon from '../../assets/v3/icons/telegram.svg';
import wordmark from '../../assets/v3/footer-wordmark.png';
import Container from '../ui/Container.astro';
import { site } from '../../data/site';
import { getLang, localizePath, navLinks, t } from '../../i18n/utils';

const lang = getLang(Astro.url);
const { nav, footer } = t(lang);
const contacts = [
  { Icon: MailIcon, value: site.email, href: `mailto:${site.email}` },
  { Icon: PhoneIcon, value: site.phone.display, href: site.phone.href },
  { Icon: TelegramIcon, value: site.telegram.handle, href: site.telegram.href },
  { Icon: InstaIcon, value: site.instagram.handle, href: site.instagram.href },
];
const col = 'flex flex-col gap-3 max-desk:gap-0';
const title =
  'mb-1 max-desk:mt-[8px] font-mono text-[13px] max-tab:text-[14px] font-medium text-amber-500';
// Phones: each link gets a 44px tap row.
const link =
  'transition-colors hover:text-amber-400 max-desk:flex max-desk:min-h-[44px] max-desk:items-center';
---

<footer class="overflow-hidden bg-ink pt-[max(88px,calc(160*var(--u)))] text-[max(15px,calc(17*var(--u)))] text-[#ededeb]">
  <Container>
    <div class="grid gap-g pb-[max(64px,calc(120*var(--u)))] desk:grid-cols-[6fr_2fr_2fr_2fr]">
      <div class="flex flex-col items-start">
        <Logo
          aria-hidden="true"
          class="mb-[max(24px,calc(40*var(--u)))] h-[max(36px,calc(48*var(--u)))] w-auto"
        />
        <p class="text-[max(26px,calc(44*var(--u)))] leading-[1.1] font-thin tracking-[-0.015em] text-snow">
          {footer.tagline[0]}
          <br />
          {footer.tagline[1]}
        </p>
      </div>

      <nav aria-label={footer.navLabel} class={col}>
        <p class={title}>{footer.navTitle}</p>
        {navLinks.map(([id, key]) => (
          <a
            href={localizePath(lang, `#${id}`)}
            class:list={['self-start', link]}
          >
            {nav[key]}
          </a>
        ))}
      </nav>

      <div class={col}>
        <p class={title}>{footer.contactTitle}</p>
        {contacts.map(({ Icon, value, href }) => (
          <a
            href={href}
            {...(href.startsWith('http') && {
              target: '_blank',
              rel: 'noopener',
            })}
            class:list={[
              'inline-flex items-center gap-2.5 self-start text-[#b9b9b4]',
              link,
            ]}
          >
            <Icon aria-hidden="true" class="size-5 flex-none" />
            {value}
          </a>
        ))}
      </div>

      <div class="flex flex-col gap-3 text-[#b9b9b4] max-desk:gap-[6px]">
        <p class={title}>{footer.studioTitle}</p>
        {footer.studio.map((line) => (
          <span>{line}</span>
        ))}
      </div>
    </div>
  </Container>

  <div class="bg-grid-dark">
    <Container class="relative">
      <hr class="border-graphite" />
      <a
        href={localizePath(lang, '#top')}
        class="group absolute top-0 right-0 flex -translate-y-1/2 items-center gap-[12px] text-[#ededeb] transition-colors hover:text-amber-400"
      >
        <span class="bg-ink px-[8px] leading-[1.2]">{footer.toTop}</span>
        <span
          aria-hidden="true"
          class="grid size-[52px] place-items-center rounded-full border-[1.5px] bg-ink border-white/50 text-[20px] transition-colors group-hover:border-amber-500 group-hover:bg-amber-500 group-hover:text-black"
        >
          ↑
        </span>
      </a>

      <!-- Decorative: the logo and the copyright already name the studio. -->
      <Image
        src={wordmark}
        alt=""
        widths={[640, 1271]}
        sizes="calc(100vw - 40px)"
        class="mt-[max(56px,calc(88*var(--u)))] mb-[max(16px,calc(32*var(--u)))] block h-auto w-full"
      />

      <p class="border-t border-graphite py-5 font-mono text-[13px] text-[#9a9a96] max-tab:text-[14px]">
        {footer.copyright}
      </p>
    </Container>
  </div>
</footer>
