---
// Testimonials ("What it's like to work with us"). Mobile: cards stacked. lg: one row that
// bleeds off the right edge (as in the desktop frame), as a CSS scroll-snap scroller: swipe,
// trackpad and keyboard work natively; two arrow buttons (Webflow has them, Figma doesn't)
// cover mouse users. Negative margin + matching padding (and scroll-padding) let the list run
// edge to edge while cards still snap to the column; cqw (the section is a size container)
// is used instead of vw, which would include the scrollbar.
import { Image } from 'astro:assets';
import Heading from '../ui/Heading.astro';
import Section from '../ui/Section.astro';
// TODO(asset): Natalia's avatar is 95px (1x); Dmytro has no photo yet.
import natalia from '../../assets/images/avatars/natalia.png';
import bram from '../../assets/images/avatars/bram.png';
import ivan from '../../assets/images/avatars/ivan.jpg';
import placeholder from '../../assets/images/avatars/placeholder.svg';
import { getLang, t } from '../../i18n/utils';

const { testimonials: tm } = t(getLang(Astro.url));
const avatars = { natalia, bram, ivan, placeholder };
---

<Section
  id="clients"
  tone="sand"
  class="@container pt-[54px] pb-[78px] lg:pt-[118px] lg:pb-[76px]"
>
  <div class="lg:flex lg:items-start lg:justify-between">
    <Heading class="lg:max-w-[620px] lg:text-wrap">{tm.title}</Heading>
    <p aria-hidden="true" class="mt-[8px] max-lg:hidden">
      {tm.label}
      <span class="ml-[25px]">|</span>
    </p>
  </div>
  <div class="lg:flex lg:items-end lg:justify-between lg:gap-8">
    <p class="mx-auto mt-[28px] max-w-[290px] text-center text-[15px] leading-[18px] lg:mx-0 lg:mt-[31px] lg:max-w-none lg:text-left lg:text-body lg:leading-[1.172]">
      {tm.sub}
    </p>
    <div class="flex shrink-0 gap-3 max-lg:hidden" data-arrows>
      {[tm.prev, tm.next].map((label, i) => (
        <button
          type="button"
          aria-label={label}
          aria-controls="testimonials-list"
          class="grid size-[48px] cursor-pointer place-items-center rounded-full border border-black transition-colors hover:bg-black hover:text-white disabled:cursor-default disabled:opacity-30 disabled:hover:bg-transparent disabled:hover:text-current"
        >
          <svg
            viewBox="0 0 10 18"
            class:list={['h-[16px]', i === 0 && 'rotate-180']}
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <path d="m1 1 8 8-8 8" />
          </svg>
        </button>
      ))}
    </div>
  </div>

  <ul
    id="testimonials-list"
    aria-label={tm.listLabel}
    class="mt-[53px] grid gap-[32px] lg:mt-[49px] lg:[--bleed:calc((100cqw-min(var(--container-content),100cqw-2*var(--spacing-gutter)))/2)] lg:-mx-(--bleed) lg:flex lg:snap-x lg:snap-mandatory lg:gap-[24px] lg:overflow-x-auto lg:scroll-smooth lg:scroll-px-(--bleed) lg:px-(--bleed) lg:[scrollbar-width:none] motion-reduce:lg:scroll-auto"
  >
    {tm.items.map((item, i) => (
      <li
        style={`--i: ${i}`}
        class="reveal mx-auto w-full max-w-[483px] lg:w-[483px] lg:shrink-0 lg:snap-start"
      >
        <figure class="flex h-full min-h-[305px] flex-col rounded-card bg-white p-[9px] lg:min-h-[451px] lg:p-[14px] lg:pb-[20px]">
          <blockquote class="px-[11px] pt-[11px] pb-6 text-center text-[20px] leading-[1.172] lg:pr-[3px] lg:pl-[5px] lg:pt-[22px] lg:text-left lg:text-[28px]">
            {item.quote.map((s, i) => (
              <>
                {i > 0 && ' '}
                <span class="lg:block">{s}</span>
              </>
            ))}
          </blockquote>
          <figcaption class="mt-auto flex min-h-[77px] items-center justify-between gap-3 rounded-[8px] bg-mist py-[7px] pr-[16px] pl-[18px] lg:min-h-[110px] lg:pr-[40px] lg:pl-[20px]">
            <span class="self-end text-[14px] leading-[17px] lg:text-[21px] lg:leading-[25px]">
              <b class="block">{item.name},</b>
              <b class="block">{item.company},</b>
              {item.project}
            </span>
            <Image
              src={avatars[item.avatar]}
              alt=""
              width={190}
              height={190}
              class="size-[60px] shrink-0 rounded-full object-cover lg:size-[95px]"
            />
          </figcaption>
        </figure>
      </li>
    ))}
  </ul>
</Section>

<script>
  // Arrows scroll by one card (+ gap) and disable at the ends.
  const list = document.getElementById('testimonials-list')!;
  const [prev, next] = document.querySelectorAll<HTMLButtonElement>(
    '[data-arrows] button',
  );
  const step = () => (list.firstElementChild as HTMLElement).offsetWidth + 24;
  const update = () => {
    // Focusable (for keyboard scrolling) only while it actually scrolls, i.e. on lg.
    list.tabIndex = list.scrollWidth > list.clientWidth ? 0 : -1;
    prev.disabled = list.scrollLeft <= 1;
    next.disabled = list.scrollLeft + list.clientWidth >= list.scrollWidth - 1;
  };
  prev.addEventListener('click', () => list.scrollBy({ left: -step() }));
  next.addEventListener('click', () => list.scrollBy({ left: step() }));
  list.addEventListener('scroll', update, { passive: true });
  addEventListener('resize', update);
  update();
</script>
