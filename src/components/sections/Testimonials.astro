---
// Testimonials: the reviews run left in an endless line (the trust
// strip's marquee, slower), paused on hover, still with reduced motion. Four copies of the three
// cards so the line never shows a gap at 1920px; only the first copy is exposed to screen readers.
// Phones: no running line; one card at a time with the design's ← 1 / 3 → pager (no swipe,
// Serhii 2026-11-28). The script slides the row to the current card.
import { Image } from 'astro:assets';
import Container from '../ui/Container.astro';
import SectionHead from '../ui/SectionHead.astro';
import { getLang, t } from '../../i18n/utils';

const { testimonials: r } = t(getLang(Astro.url));
const avatars = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/v3/reviews/*.png',
  {
    eager: true,
  },
);
const avatar = (name: string) =>
  avatars[`../../assets/v3/reviews/${name}.png`].default;
---

<section class="border-t border-line bg-warm-50 py-[max(80px,calc(140*var(--u)))]">
  <Container>
    <SectionHead label={r.label} title={r.title} lead={r.sub} />
  </Container>
  <div
    data-reviews
    data-total={r.items.length}
    class="overflow-hidden py-[4px] max-tab:px-[20px]"
  >
    <ul
      aria-label={r.listLabel}
      data-row
      class="flex w-max transition-transform duration-500 ease-mv motion-reduce:transition-none [animation-delay:-30s] [animation-duration:90s] hover:[animation-play-state:paused] tab:motion-safe:animate-marquee"
    >
      {[0, 1, 2, 3].map((copy) =>
        r.items.map((item) => (
          <li
            aria-hidden={copy ? 'true' : undefined}
            class:list={[
              'mr-[16px] max-tab:mr-[24px] h-[max(400px,calc(480*var(--u)))] w-[calc(100vw-40px)] shrink-0 tab:w-[max(300px,calc(560*var(--u)))]',
              copy && 'max-tab:hidden',
            ]}
          >
            <figure class="flex h-full flex-col rounded-[12px] border border-line bg-snow p-[max(24px,calc(36*var(--u)))]">
              <span
                aria-hidden="true"
                class="h-[28px] font-head text-[56px] leading-[0.6] font-extrabold text-amber-500"
              >
                “
              </span>
              <blockquote
                lang={item.lang}
                class="line-clamp-7 text-quote leading-[1.45] text-ink"
              >
                {item.quote}
              </blockquote>
              <figcaption class="mt-auto flex items-center gap-[14px] border-t border-line pt-[20px]">
                <Image
                  src={avatar(item.avatar)}
                  alt=""
                  width={104}
                  height={104}
                  class="size-[52px] shrink-0 rounded-full bg-warm-100 object-cover"
                />
                <span class="min-w-0">
                  <strong class="block font-medium text-black">
                    {item.name}
                  </strong>
                  <em class="block truncate font-mono text-[13px] text-text-3 not-italic">
                    {item.project}
                  </em>
                </span>
              </figcaption>
            </figure>
          </li>
        )),
      )}
    </ul>
    <div class="mt-[24px] flex items-center justify-center gap-[20px] tab:hidden">
      <button
        type="button"
        data-step="-1"
        aria-label={r.prev}
        class="grid size-[48px] place-items-center rounded-full border border-line bg-snow text-[20px] text-black transition-colors hover:border-amber-500 disabled:cursor-default disabled:opacity-35 disabled:hover:border-line"
      >
        <span aria-hidden="true">←</span>
      </button>
      <span class="min-w-[4ch] text-center font-mono text-[15px] text-text-2">
        <span data-cur>1</span> / {r.items.length}
      </span>
      <button
        type="button"
        data-step="1"
        aria-label={r.next}
        class="grid size-[48px] place-items-center rounded-full border border-line bg-snow text-[20px] text-black transition-colors hover:border-amber-500 disabled:cursor-default disabled:opacity-35 disabled:hover:border-line"
      >
        <span aria-hidden="true">→</span>
      </button>
    </div>
  </div>
</section>

<script>
  // Phone pager: slide the row so the current card starts at the column.
  for (const box of document.querySelectorAll<HTMLElement>('[data-reviews]')) {
    const row = box.querySelector<HTMLElement>('[data-row]')!;
    const cards = [...row.children] as HTMLElement[];
    const total = Number(box.dataset.total);
    const cur = box.querySelector('[data-cur]')!;
    const [prev, next] = box.querySelectorAll<HTMLButtonElement>('[data-step]');
    let i = 0;
    const show = (n: number) => {
      i = Math.max(0, Math.min(total - 1, n));
      row.style.transform = matchMedia('(width < 37.5625rem)').matches
        ? `translateX(${cards[0].offsetLeft - cards[i].offsetLeft}px)`
        : '';
      cur.textContent = String(i + 1);
      prev.disabled = i === 0;
      next.disabled = i === total - 1;
    };
    prev.onclick = () => show(i - 1);
    next.onclick = () => show(i + 1);
    addEventListener('resize', () => show(i));
    show(0);
  }
</script>
