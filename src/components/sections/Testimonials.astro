---
// Testimonials: the reviews run left in an endless line (the trust
// strip's marquee, slower), paused on hover, still with reduced motion. Four copies of the three
// cards so the line never shows a gap at 1920px; only the first copy is exposed to screen readers.
// Phones: no running line, a swipe row with snap instead of the design's ← 1 / 3 → pager.
import { Image } from 'astro:assets';
import Container from '../ui/Container.astro';
import SectionHead from '../ui/SectionHead.astro';
import { getLang, t } from '../../i18n/utils';

const { testimonials: r } = t(getLang(Astro.url));
const avatars = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/v3/reviews/*.png',
  {
    eager: true,
  },
);
const avatar = (name: string) =>
  avatars[`../../assets/v3/reviews/${name}.png`].default;
---

<section class="border-t border-line bg-warm-50 py-[max(80px,calc(140*var(--u)))]">
  <Container>
    <SectionHead label={r.label} title={r.title} lead={r.sub} />
  </Container>
  <div class="overflow-hidden py-[4px] max-tab:snap-x max-tab:snap-mandatory max-tab:scroll-px-[20px] max-tab:overflow-x-auto max-tab:px-[20px]">
    <ul
      aria-label={r.listLabel}
      class="flex w-max [animation-delay:-30s] [animation-duration:90s] hover:[animation-play-state:paused] tab:motion-safe:animate-marquee"
    >
      {[0, 1, 2, 3].map((copy) =>
        r.items.map((item) => (
          <li
            aria-hidden={copy ? 'true' : undefined}
            class:list={[
              'mr-[16px] h-[max(400px,calc(480*var(--u)))] w-[min(84vw,340px)] shrink-0 snap-center tab:w-[max(300px,calc(560*var(--u)))]',
              copy && 'max-tab:hidden',
            ]}
          >
            <figure class="flex h-full flex-col rounded-[12px] border border-line bg-snow p-[max(24px,calc(36*var(--u)))]">
              <span
                aria-hidden="true"
                class="h-[28px] font-head text-[56px] leading-[0.6] font-extrabold text-amber-500"
              >
                “
              </span>
              <blockquote
                lang={item.lang}
                class="line-clamp-7 text-quote leading-[1.45] text-ink"
              >
                {item.quote}
              </blockquote>
              <figcaption class="mt-auto flex items-center gap-[14px] border-t border-line pt-[20px]">
                <Image
                  src={avatar(item.avatar)}
                  alt=""
                  width={104}
                  height={104}
                  class="size-[52px] shrink-0 rounded-full bg-warm-100 object-cover"
                />
                <span class="min-w-0">
                  <strong class="block font-medium text-black">
                    {item.name}
                  </strong>
                  <em class="block truncate font-mono text-[13px] text-text-3 not-italic">
                    {item.project}
                  </em>
                </span>
              </figcaption>
            </figure>
          </li>
        )),
      )}
    </ul>
  </div>
</section>
