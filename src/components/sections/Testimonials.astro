---
// Testimonials ("What it's like to work with us"). One CSS scroll-snap row at every size:
// swipe, trackpad and keyboard work natively. Mobile: one card per view, the next one peeking
// in the gutter, plus a "2 / 6" counter. lg: the row bleeds off the right edge (as in the
// desktop frame); two arrow buttons (Webflow has them, Figma doesn't) cover mouse users. Negative margin + matching padding (and scroll-padding) let the list run
// edge to edge while cards still snap to the column; cqw (the section is a size container)
// is used instead of vw, which would include the scrollbar.
// Infinite: the items render three times (the outer copies are inert, so screen readers and Tab
// see each card once); the script starts on the middle copy and, once scrolling settles in an
// outer copy, jumps one copy's width back. Same cards there, so the jump is invisible.
import { Image } from 'astro:assets';
import Heading from '../ui/Heading.astro';
import Section from '../ui/Section.astro';
// TODO(asset): Natalia's avatar is 95px (1x).
// TODO(photo): Dmytro, Julia and Daria have no photos yet; they get initials circles (avatar: 'placeholder').
import natalia from '../../assets/images/avatars/natalia.png';
import bram from '../../assets/images/avatars/bram.png';
import ivan from '../../assets/images/avatars/ivan.jpg';
import { getLang, t } from '../../i18n/utils';

const { testimonials: tm } = t(getLang(Astro.url));
const avatars = { natalia, bram, ivan };
// "Dmytro V." -> "DV" (Cyrillic on /uk/). Placeholder tints cycle through the orange ramp.
const initials = (name: string) => name.match(/\p{Lu}/gu)?.join('') ?? '';
const tints = ['bg-orange-200', 'bg-orange', 'bg-orange-300'];
const looped = [0, 1, 2].flatMap((copy) =>
  tm.items.map((item, i) => ({ item, i, clone: copy !== 1 })),
);
---

<Section
  id="clients"
  tone="sand"
  class="@container pt-[54px] pb-[78px] lg:pt-[118px] lg:pb-[76px]"
>
  <div class="lg:flex lg:items-start lg:justify-between">
    <Heading class="lg:max-w-[620px] lg:text-wrap">{tm.title}</Heading>
    <p aria-hidden="true" class="mt-[8px] max-lg:hidden">
      {tm.label}
      <span class="ml-[25px]">|</span>
    </p>
  </div>
  <div class="lg:flex lg:items-end lg:justify-between lg:gap-8">
    <p class="mx-auto mt-[28px] max-w-[290px] text-center text-[15px] leading-[18px] lg:mx-0 lg:mt-[31px] lg:max-w-none lg:text-left lg:text-body lg:leading-[1.172]">
      {tm.sub}
    </p>
    <div class="flex shrink-0 gap-3 max-lg:hidden" data-arrows>
      {[tm.prev, tm.next].map((label, i) => (
        <button
          type="button"
          aria-label={label}
          aria-controls="testimonials-list"
          class="grid size-[48px] cursor-pointer place-items-center rounded-full border border-black transition-colors hover:bg-black hover:text-white"
        >
          <svg
            viewBox="0 0 10 18"
            class:list={['h-[16px]', i === 0 && 'rotate-180']}
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <path d="m1 1 8 8-8 8" />
          </svg>
        </button>
      ))}
    </div>
  </div>

  <ul
    id="testimonials-list"
    aria-label={tm.listLabel}
    class="reveal mt-[53px] flex snap-x snap-mandatory scroll-px-(--bleed) gap-[16px] overflow-x-auto scroll-smooth px-(--bleed) [--bleed:calc((100cqw-min(var(--container-content),100cqw-2*var(--spacing-gutter)))/2)] [scrollbar-width:none] -mx-(--bleed) motion-reduce:scroll-auto lg:mt-[49px] lg:gap-[24px]"
  >
    {looped.map(({ item, i, clone }) => (
      <li
        class="w-[88%] max-w-[483px] shrink-0 snap-start lg:w-[483px]"
        inert={clone}
      >
        <figure class="flex h-full min-h-[305px] flex-col rounded-card bg-white p-[9px] lg:min-h-[451px] lg:p-[14px] lg:pb-[20px]">
          <blockquote class="px-[11px] pt-[11px] pb-6 text-center text-[20px] leading-[1.172] lg:pr-[3px] lg:pl-[5px] lg:pt-[22px] lg:text-left lg:text-[28px]">
            {item.quote.map((s, i) => (
              <>
                {i > 0 && ' '}
                <span class="lg:block">{s}</span>
              </>
            ))}
          </blockquote>
          <figcaption class="mt-auto flex min-h-[77px] items-center justify-between gap-3 rounded-[8px] bg-mist py-[7px] pr-[16px] pl-[18px] lg:min-h-[110px] lg:pr-[40px] lg:pl-[20px]">
            <span class="self-end text-[14px] leading-[17px] lg:text-[21px] lg:leading-[25px]">
              <b class="block">{item.name},</b>
              <b class="block">{item.company},</b>
              {item.project}
            </span>
            {item.avatar === 'placeholder' ? (
              <span
                aria-hidden="true"
                class:list={[
                  'grid size-[60px] shrink-0 place-items-center rounded-full text-[20px] font-medium lg:size-[95px] lg:text-[32px]',
                  tints[i % tints.length],
                ]}
              >
                {initials(item.name)}
              </span>
            ) : (
              <Image
                src={avatars[item.avatar]}
                alt=""
                width={190}
                height={190}
                class="size-[60px] shrink-0 rounded-full object-cover lg:size-[95px]"
              />
            )}
          </figcaption>
        </figure>
      </li>
    ))}
  </ul>
  <p
    class="mt-[24px] text-center text-[15px] tabular-nums lg:hidden"
    data-counter
  >
    1 / {tm.items.length}
  </p>
</Section>

<script>
  // Arrows (lg) scroll by one card (+ gap); the counter (mobile) shows the card snapped at the
  // start. The list holds three copies of the items (see the top comment).
  const list = document.getElementById('testimonials-list')!;
  const counter = document.querySelector<HTMLElement>('[data-counter]')!;
  const [prev, next] = document.querySelectorAll<HTMLButtonElement>(
    '[data-arrows] button',
  );
  const n = list.children.length / 3;
  const step = () =>
    (list.firstElementChild as HTMLElement).offsetWidth +
    parseFloat(getComputedStyle(list).columnGap);
  // Back into the middle copy, instantly (the list is scroll-smooth).
  const recenter = () => {
    const set = n * step();
    const shift =
      list.scrollLeft < set - 1
        ? set
        : list.scrollLeft >= 2 * set - 1
          ? -set
          : 0;
    if (shift)
      list.scrollTo({ left: list.scrollLeft + shift, behavior: 'instant' });
  };
  let settle: ReturnType<typeof setTimeout>;
  const update = () => {
    // Focusable (arrow keys scroll it) only while it actually scrolls.
    list.tabIndex = list.scrollWidth > list.clientWidth ? 0 : -1;
    const i = Math.round(list.scrollLeft / step());
    counter.textContent = `${(i % n) + 1} / ${n}`;
    // ponytail: timer instead of `scrollend` (not in older Safari).
    clearTimeout(settle);
    settle = setTimeout(recenter, 150);
  };
  prev.addEventListener('click', () => list.scrollBy({ left: -step() }));
  next.addEventListener('click', () => list.scrollBy({ left: step() }));
  list.addEventListener('scroll', update, { passive: true });
  addEventListener('resize', update);
  list.scrollTo({ left: n * step(), behavior: 'instant' });
  update();
</script>
