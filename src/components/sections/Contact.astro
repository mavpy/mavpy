---
// Contact: one white card, contacts on the left (4fr) and the form in an
// amber frame on the right (8fr); below 1200px they stack, and on phones the form comes first.
// Pages are static, so the form posts through the `contact` action from a script (JS required).
// Validation: native constraints, shown as our own localized inline errors (the design has one
// message for the whole form); the server re-checks.
// Phone: a country-code picker (a transparent native select over a "🇺🇦 +380" label, so keyboard,
// screen readers and mobile pickers work as usual) plus the national number; toE164 (shared with
// the server) checks it. goal: preset by a pricing plan's button, sent to Telegram as the plan name.
import Arrow from '../ui/Arrow.astro';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import Input from '../ui/Input.astro';
import SectionHead from '../ui/SectionHead.astro';
import PhoneIcon from '../../assets/v3/icons/phone.svg';
import MailIcon from '../../assets/v3/icons/mail.svg';
import InstaIcon from '../../assets/v3/icons/insta.svg';
import TelegramIcon from '../../assets/v3/icons/telegram.svg';
import { countries, dialCodes, flag } from '../../data/phone';
import { site } from '../../data/site';
import { getLang, t } from '../../i18n/utils';

const lang = getLang(Astro.url);
const { contact } = t(lang);
const messages = {
  ...contact.errors,
  error: `${contact.error} ${site.email}.`,
};
const plaques = [
  {
    Icon: PhoneIcon,
    label: contact.side.phone,
    value: site.phone.display,
    href: site.phone.href,
  },
  {
    Icon: MailIcon,
    label: contact.side.email,
    value: site.email,
    href: `mailto:${site.email}`,
  },
  {
    Icon: TelegramIcon,
    label: contact.side.telegram,
    value: site.telegram.handle,
    href: site.telegram.href,
  },
  {
    Icon: InstaIcon,
    label: contact.side.instagram,
    value: site.instagram.handle,
    href: site.instagram.href,
  },
];

// Country names in the page language; Ukraine (the default) first, the rest alphabetical.
const names = new Intl.DisplayNames([lang], { type: 'region' });
const collator = new Intl.Collator(lang);
const [first, ...rest] = countries;
rest.sort((a, b) => collator.compare(names.of(a)!, names.of(b)!));
const short = (c: keyof typeof dialCodes) => `${flag(c)} +${dialCodes[c]}`;
---

<section
  id="contact"
  class="scroll-mt-[max(72px,calc(108*var(--u)))] bg-warm-100 py-[max(80px,calc(140*var(--u)))]"
>
  <Container>
    <SectionHead
      label={contact.label}
      title={contact.title}
      lead={contact.sub}
    />
    <div
      data-ri
      class="grid gap-[max(24px,calc(48*var(--u)))] rounded-[16px] border border-line bg-snow p-[16px] desk:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] desk:p-[max(20px,calc(40*var(--u)))]"
    >
      <div class="flex flex-col">
        <p class="mb-[max(12px,calc(16*var(--u)))] text-[max(18px,calc(24*var(--u)))] font-medium text-black">
          {contact.side.title}
        </p>
        {plaques.map(({ Icon, label, value, href }) => (
          <a
            href={href}
            {...(href.startsWith('http') && {
              target: '_blank',
              rel: 'noopener',
            })}
            class="flex flex-1 items-center gap-[16px] border-t border-line py-[max(14px,calc(18*var(--u)))] text-small text-black transition-colors last:border-b hover:text-amber-700"
          >
            <span class="grid size-[48px] shrink-0 place-items-center rounded-full bg-warm-50 text-black">
              <Icon aria-hidden="true" class="size-[22px]" />
            </span>
            <span>
              <strong class="block font-medium">{label}</strong>
              <em class="block text-text-2 not-italic">{value}</em>
            </span>
          </a>
        ))}
      </div>

      <div class="rounded-[12px] border-2 border-amber-500 bg-snow p-[20px] max-tab:order-first desk:p-[max(24px,calc(56*var(--u)))]">
        <form method="post" novalidate data-messages={JSON.stringify(messages)}>
          <div class="grid gap-x-g gap-y-[28px] desk:grid-cols-2">
            <Input
              label={contact.name}
              name="name"
              autocomplete="name"
              placeholder={contact.namePlaceholder}
              required
              minlength={2}
              maxlength={100}
            />
            <Input
              label={contact.email}
              name="email"
              type="email"
              autocomplete="email"
              placeholder={contact.emailPlaceholder}
              required
              maxlength={254}
            />
            <Input
              label={contact.phone}
              name="phone"
              type="tel"
              autocomplete="tel-national"
              placeholder={contact.phoneHint}
              data-hint={contact.phoneHint}
              required
              maxlength={30}
              class="col-span-full"
            >
              <div
                slot="prefix"
                class="frame relative flex shrink-0 items-center gap-[8px] px-[14px] [&:has(~[aria-invalid=true])]:border-error"
              >
                <span data-dial class="whitespace-nowrap" aria-hidden="true">
                  {short(first)}
                </span>
                <svg
                  viewBox="0 0 89 45"
                  class="w-[12px]"
                  fill="none"
                  stroke="currentColor"
                  aria-hidden="true"
                >
                  <path
                    d="M1 1 44.5 44 88 1"
                    stroke-width="2"
                    vector-effect="non-scaling-stroke"
                  />
                </svg>
                <select
                  name="country"
                  aria-label={contact.country}
                  class="absolute inset-0 cursor-pointer opacity-0"
                >
                  {[first, ...rest].map((c) => (
                    <option value={c} data-short={short(c)}>
                      {flag(c)} {names.of(c)} +{dialCodes[c]}
                    </option>
                  ))}
                </select>
              </div>
            </Input>
          </div>
          <input type="hidden" name="goal" value="" />
          <input type="hidden" name="locale" value={lang} />
          <!-- Honeypot: off-screen and out of the tab order; people never see it, bots fill it. -->
          <div class="absolute -left-[9999px]" aria-hidden="true">
            <input
              type="text"
              name="website"
              tabindex="-1"
              autocomplete="off"
            />
          </div>
          <div class="mt-[36px] flex flex-wrap items-center gap-x-[20px] gap-y-[16px]">
            <Button type="submit" class="max-tab:w-full">
              {contact.cta}
              <span
                aria-hidden="true"
                class="inline-flex transition-transform duration-200 ease-mv group-hover/btn:translate-x-[5px]"
              >
                <Arrow />
              </span>
            </Button>
            <span class="font-mono text-[max(13px,calc(15*var(--u)))] max-tab:text-[14px] text-text-3">
              {contact.reply}
            </span>
          </div>
          <!-- Form-level error (delivery failed); values stay in the form. -->
          <p
            role="status"
            class="mt-[16px] text-[15px] text-error empty:hidden"
          ></p>
        </form>

        <!-- Shown in place of the form after a successful submit, at the form's height. -->
        <div
          id="contact-success"
          hidden
          tabindex="-1"
          class="flex flex-col items-start justify-center gap-[8px] outline-none motion-safe:transition-opacity motion-safe:duration-500 motion-safe:starting:opacity-0 [&[hidden]]:hidden"
        >
          <h3 class="font-head text-h3 leading-[1.05] font-bold tracking-[-0.005em] text-black">
            {contact.successTitle}
          </h3>
          <p class="text-body text-text-2">{contact.success}</p>
          <!-- Bot confirmation (t.me deep link with the lead id). Shown by the script when the server
               returns a link; leads without an id (Airtable down) just don't get the button. -->
          <Button
            href="#"
            data-telegram
            hidden
            target="_blank"
            rel="noopener"
            tone="telegram"
            class="mt-[16px] [&[hidden]]:hidden"
          >
            <svg
              viewBox="0 0 24 24"
              class="size-[1.1em] shrink-0"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M9.78 18.65l.28-4.23 7.68-6.92c.34-.31-.07-.46-.52-.19L7.74 13.3 3.64 12c-.88-.25-.89-.86.2-1.3l15.97-6.16c.73-.33 1.43.18 1.15 1.3l-2.72 12.81c-.19.91-.74 1.13-1.5.71L12.6 16.3l-1.99 1.93c-.23.23-.42.42-.83.42z" />
            </svg>
            {contact.telegram}
          </Button>
        </div>
      </div>
    </div>
  </Container>
</section>

<script>
  import { actions, isInputError } from 'astro:actions';
  import { toE164 } from '../../data/phone';

  const form = document.querySelector<HTMLFormElement>('#contact form')!;
  const button = form.querySelector<HTMLButtonElement>('[type=submit]')!;
  const status = form.querySelector<HTMLElement>('[role=status]')!;
  const success = document.getElementById('contact-success')!;
  const msg = JSON.parse(form.dataset.messages!);
  const loadedAt = Date.now();
  const fields = [
    ...form.querySelectorAll<HTMLInputElement>('input[id^=field-]'),
  ];
  const phone = form.elements.namedItem('phone') as HTMLInputElement;
  const country = form.elements.namedItem('country') as HTMLSelectElement;
  const dial = form.querySelector<HTMLElement>('[data-dial]')!;

  // A filled-in number that can't be real → customError ("Enter a valid phone number").
  const syncPhone = () =>
    phone.setCustomValidity(
      phone.value.trim() && !toE164(country.value, phone.value)
        ? msg.phone
        : '',
    );

  // Show the picked code; the +380 example hint only fits Ukrainian numbers.
  country.addEventListener('change', () => {
    dial.textContent = country.selectedOptions[0].dataset.short!;
    phone.placeholder = country.value === 'UA' ? phone.dataset.hint! : '';
  });

  function setError(el: HTMLInputElement, text: string) {
    const errorId = `${el.id}-error`;
    document.getElementById(errorId)!.textContent = text;
    // "true", not just present: Tailwind's aria-invalid: variant matches [aria-invalid="true"].
    if (text) {
      el.setAttribute('aria-invalid', 'true');
      el.setAttribute('aria-describedby', errorId);
    } else {
      el.removeAttribute('aria-invalid');
      el.removeAttribute('aria-describedby');
    }
  }

  const errorFor = ({ validity: v }: HTMLInputElement) =>
    v.valueMissing
      ? msg.required
      : v.customError
        ? msg.phone
        : v.typeMismatch
          ? msg.email
          : v.tooShort
            ? msg.short
            : '';

  const setStatus = (text = '') => (status.textContent = text);

  // Clear errors as soon as fields become valid (a new country can also fix the phone).
  form.addEventListener('input', () => {
    syncPhone();
    fields.forEach((el) => el.validity.valid && setError(el, ''));
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    setStatus();
    syncPhone();
    const invalid = fields.filter(
      (el) => (setError(el, errorFor(el)), !el.validity.valid),
    );
    if (invalid.length) return invalid[0].focus();

    const data = new FormData(form);
    data.set('elapsed', String(Date.now() - loadedAt));
    button.disabled = true;
    button.setAttribute('aria-busy', 'true');
    let error: unknown;
    let telegram: string | undefined;
    try {
      let result;
      ({ data: result, error } = await actions.contact(data));
      telegram = result?.telegram;
    } catch (err) {
      error = err; // offline / network failure
    }
    button.disabled = false;
    button.removeAttribute('aria-busy');

    if (!error) {
      // Swap the form for the thank-you card at the same height, so the page doesn't jump,
      // and move focus there so screen readers announce it.
      success.style.minHeight = `${form.offsetHeight}px`;
      const link = success.querySelector<HTMLAnchorElement>('[data-telegram]')!;
      if (telegram) {
        link.href = telegram;
        link.hidden = false;
      }
      form.hidden = true;
      success.hidden = false;
      success.focus();
      return;
    }
    // Server-side validation caught something the browser didn't: mark those fields.
    if (isInputError(error)) {
      const bad = fields.filter(
        (el) => error.fields[el.name as keyof typeof error.fields],
      );
      bad.forEach((el) =>
        setError(
          el,
          el.type === 'email'
            ? msg.email
            : el === phone
              ? msg.phone
              : msg.short,
        ),
      );
      if (bad.length) return bad[0].focus();
    }
    // Delivery failed: values stay in the form, and the message gives our e-mail.
    // Disabling the button dropped focus to <body>; put it back so keyboard users can retry.
    setStatus(msg.error);
    button.focus();
  });
</script>
