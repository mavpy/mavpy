---
// Contact ("Tell us your goal, we'll price it"). Restyled on purpose, not a 1:1 copy of the frame
// (the Figma block looks unfinished): shared h2 and subline, one underline field style everywhere,
// the lg button. Structure, copy and outer spacing follow the frames.
// lg: sand card with an orange left border around a white form card. Mobile: no sand card (as in
// the mobile frame). The form is a 2-column grid; each field is a 3-row subgrid (label, control,
// error), so the button sits on the select's row however tall the error text gets.
// Pages are static, so the form posts through the `contact` action from a script (JS required).
// Validation: native constraints, shown as our own localized inline errors; the server re-checks.
import Button from '../ui/Button.astro';
import Heading from '../ui/Heading.astro';
import Input from '../ui/Input.astro';
import Section from '../ui/Section.astro';
import { goalIds, goalLabel } from '../../data/goals';
import { site } from '../../data/site';
import { getLang, t } from '../../i18n/utils';

const lang = getLang(Astro.url);
const dict = t(lang);
const { contact } = dict;
const messages = {
  ...contact.errors,
  error: `${contact.error} ${site.email}`,
};
const field = 'lg:row-span-3 lg:grid lg:grid-rows-subgrid lg:gap-y-2';
---

<Section id="contact" class="pt-[80px] pb-[82px] lg:pt-[113px] lg:pb-[192px]">
  <div class="lg:-ml-[4px] lg:rounded-card lg:border-l-[5px] lg:border-orange lg:bg-sand lg:px-[109px] lg:pt-[62px] lg:pb-[58px]">
    <!-- Centred on desktop too, unlike other h2s: it's the closing call to action. -->
    <Heading center class="mx-auto max-w-[720px]">
      {contact.title}
    </Heading>
    <p class="mx-auto mt-[23px] max-w-[290px] text-center text-[15px] leading-[18px] lg:mt-[30px] lg:max-w-[30em] lg:text-body lg:leading-[1.172]">
      {contact.sub}
    </p>

    <form
      method="post"
      novalidate
      data-messages={JSON.stringify(messages)}
      class="reveal mt-[49px] grid gap-y-3 rounded-card bg-white px-[21px] pt-[30px] pb-[12px] lg:mt-[44px] lg:grid-cols-2 lg:gap-x-[64px] lg:gap-y-0 lg:px-[73px] lg:pt-[42px] lg:pb-[20px]"
    >
      <Input
        label={contact.name}
        name="name"
        autocomplete="name"
        required
        minlength={2}
        maxlength={100}
        class={field}
      />
      <Input
        label={contact.email}
        name="email"
        type="email"
        autocomplete="email"
        required
        maxlength={254}
        class={field}
      />
      <Input
        as="select"
        label={contact.goal}
        name="goal"
        required
        class={field}
      >
        {goalIds.map((id) => (
          <option value={id}>{goalLabel(dict, id)}</option>
        ))}
      </Input>
      <input type="hidden" name="locale" value={lang} />
      <!-- Honeypot: off-screen and out of the tab order; people never see it, bots fill it. -->
      <div class="absolute -left-[9999px]" aria-hidden="true">
        <input type="text" name="website" tabindex="-1" autocomplete="off" />
      </div>
      <Button
        type="submit"
        block
        class="mt-4 lg:col-start-2 lg:row-start-5 lg:mt-0 lg:w-auto lg:self-center lg:justify-self-start"
      >
        {contact.cta}
      </Button>
      <!-- Form-level error message, styled like the field errors. On lg it sits in the button's
           error row, so its space is already reserved. -->
      <p
        role="status"
        class="mt-2 min-h-[1.2em] text-btn-sm text-error lg:col-start-2 lg:row-start-6"
      ></p>
    </form>

    <!-- Shown in place of the form after a successful submit: same card, fades in (motion-safe). -->
    <div
      id="contact-success"
      hidden
      tabindex="-1"
      class="mt-[49px] flex flex-col items-center justify-center rounded-card bg-white px-[21px] py-[48px] text-center outline-none focus-visible:shadow-none lg:mt-[44px] lg:px-[73px] motion-safe:transition-opacity motion-safe:duration-500 motion-safe:starting:opacity-0"
    >
      <span
        class="flex size-[64px] items-center justify-center rounded-full bg-orange lg:size-[80px]"
        aria-hidden="true"
      >
        <svg
          viewBox="0 0 24 24"
          class="w-1/2"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M5 12.5 10 17.5 19 7" />
        </svg>
      </span>
      <Heading as="h3" size="card" class="mt-6">
        {contact.successTitle}
      </Heading>
      <p class="mt-3 max-w-[24em] text-body text-grey">{contact.success}</p>
    </div>
  </div>
</Section>

<script>
  import { actions, isInputError } from 'astro:actions';

  const form = document.querySelector<HTMLFormElement>('#contact form')!;
  const button = form.querySelector<HTMLButtonElement>('[type=submit]')!;
  const status = form.querySelector<HTMLElement>('[role=status]')!;
  const success = document.getElementById('contact-success')!;
  const msg = JSON.parse(form.dataset.messages!);
  const loadedAt = Date.now();
  const fields = [
    ...form.querySelectorAll<HTMLInputElement>(
      'input[id^=field-], select[id^=field-]',
    ),
  ];

  function setError(el: HTMLInputElement, text: string) {
    const errorId = `${el.id}-error`;
    document.getElementById(errorId)!.textContent = text;
    // "true", not just present: Tailwind's aria-invalid: variant matches [aria-invalid="true"].
    if (text) {
      el.setAttribute('aria-invalid', 'true');
      el.setAttribute('aria-describedby', errorId);
    } else {
      el.removeAttribute('aria-invalid');
      el.removeAttribute('aria-describedby');
    }
  }

  const errorFor = ({ validity: v }: HTMLInputElement) =>
    v.valueMissing
      ? msg.required
      : v.typeMismatch
        ? msg.email
        : v.tooShort
          ? msg.short
          : '';

  const setStatus = (text = '') => (status.textContent = text);

  // Clear a field's error as soon as it becomes valid.
  form.addEventListener('input', (e) => {
    const el = e.target as HTMLInputElement;
    if (el.validity.valid && fields.includes(el)) setError(el, '');
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    setStatus();
    const invalid = fields.filter(
      (el) => (setError(el, errorFor(el)), !el.validity.valid),
    );
    if (invalid.length) return invalid[0].focus();

    const data = new FormData(form);
    data.set('elapsed', String(Date.now() - loadedAt));
    button.disabled = true;
    button.setAttribute('aria-busy', 'true');
    let error: unknown;
    try {
      ({ error } = await actions.contact(data));
    } catch (err) {
      error = err; // offline / network failure
    }
    button.disabled = false;
    button.removeAttribute('aria-busy');

    if (!error) {
      // Swap the form for the thank-you card at the same height, so the page doesn't jump,
      // and move focus there so screen readers announce it.
      success.style.minHeight = `${form.offsetHeight}px`;
      form.hidden = true;
      success.hidden = false;
      success.focus();
      return;
    }
    // Server-side validation caught something the browser didn't: mark those fields.
    if (isInputError(error)) {
      const bad = fields.filter(
        (el) => error.fields[el.name as keyof typeof error.fields],
      );
      bad.forEach((el) =>
        setError(el, el.type === 'email' ? msg.email : msg.short),
      );
      if (bad.length) return bad[0].focus();
    }
    // Delivery failed: values stay in the form, and the message gives our e-mail.
    setStatus(msg.error);
  });
</script>
