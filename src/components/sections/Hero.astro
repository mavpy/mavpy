---
// Hero + trust strip (design .mv-hero / .mv-strip). Desktop: tagline, «MORE» with three bars,
// «clients» filling the container, «Not just a new website» pinned top-right, note + CTA bottom-right.
// Below 1200px everything stacks and the statement sits right-aligned under «clients». Phones keep
// a reserved third line below it (more air); tablets don't (Serhii, 2026-11-28).
// The CTA leads to the prices: «Find out the cost» should land on the cost (2026-11-28).
// The tagline stays the h1: the design puts «MORE clients» in the h1, which says
// little to search engines or screen readers.
import Arrow from '../ui/Arrow.astro';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import { getLang, t } from '../../i18n/utils';

const { hero, trust } = t(getLang(Astro.url));
const [s1, s2, s3] = hero.statement;
const mask = 'overflow-x-visible overflow-y-clip'; // clips the slide-up, not the sides
---

<section id="top" class="relative overflow-hidden bg-warm-50">
  <div
    aria-hidden="true"
    class="absolute inset-0 [--d:1.05s] motion-safe:animate-fade-in"
  >
    <div class="absolute inset-0 bg-grid"></div>
    <div
      data-streaks
      class="absolute inset-0 overflow-hidden motion-reduce:hidden"
    ></div>
  </div>

  <Container class="relative pt-[28px] pb-[48px] desk:pt-[calc(50*var(--u))] desk:pb-[calc(56*var(--u))]">
    <!-- @container: «clients» is sized in cqw so it fills the container width exactly. -->
    <div class="@container relative flex flex-col desk:block">
      <h1 class="text-[clamp(16px,4.2vw,22px)] leading-[1.2] font-medium text-black [--d:.45s] motion-safe:animate-blur-in desk:text-[max(14px,calc(23*var(--u)))]">
        {hero.h1.before}
        <strong class="font-bold">{hero.h1.em}</strong>
        {hero.h1.after}
      </h1>

      <p aria-hidden="true" class={mask}>
        <span class="mt-[14px] flex items-baseline gap-[4px] pb-[0.06em] font-hegarty text-[calc(20vw-8px)] leading-[0.74] tracking-[0.05em] whitespace-nowrap text-black motion-safe:animate-mask-up uk:font-montserrat uk:font-black uk:tracking-[0.02em] desk:mt-[calc(18*var(--u))] desk:ml-[calc(6*var(--u))] desk:gap-[calc(2*var(--u))] desk:text-[calc(135*var(--u))]">
          <span class="flex h-cap gap-[min(1.4vw,8px)] *:h-full *:bg-black motion-safe:animate-bars-left desk:gap-[calc(8*var(--u))]">
            <i class="w-[min(2vw,11px)] desk:w-[calc(11*var(--u))]"></i>
            <i class="w-[min(1.5vw,8px)] desk:w-[calc(8*var(--u))]"></i>
            <i class="w-[min(4.6vw,26px)] desk:w-[calc(26*var(--u))]"></i>
          </span>
          <span class="inline-block motion-safe:animate-wipe">{hero.more}</span>
        </span>
      </p>

      <p aria-hidden="true" class={mask}>
        <span class="mt-[20px] -ml-[0.035em] block w-max font-helvetica text-[length:calc(100cqw/var(--clients-em))] leading-[0.82] font-thin tracking-[0.04em] text-black [--clients-em:2.913] [--d:.15s] motion-safe:animate-mask-up uk:tracking-[0.015em] uk:[--clients-em:3.259] uk:max-desk:mb-[0.078em] uk:max-desk:tracking-[0.01em] uk:max-desk:[--clients-em:3.224] desk:mt-[calc(56*var(--u))]">
          {hero.clients}
        </span>
      </p>
      <!-- The two display words are decorative; this is what they say. -->
      <p class="sr-only">
        {hero.more} {hero.clients}
      </p>

      <p class="mt-[20px] min-h-[3.2em] w-full self-end tab:mt-0 tab:min-h-0 text-right font-head text-[clamp(34px,10vw,60px)] leading-none font-extrabold tracking-[-0.02em] text-black desk:absolute desk:top-0 desk:right-0 desk:mt-0 desk:w-auto desk:text-[calc(48*var(--u))] desk:leading-[calc(47*var(--u))]">
        <span class="sr-only">
          {s1} {s2} {s3}
        </span>
        <span aria-hidden="true" data-type>
          <span>{s1}</span>
          <br />
          <span>{s2}</span>
          <br class="max-desk:hidden" /> <span>{s3}</span>
        </span>
      </p>
    </div>

    <div class="mt-[40px] flex flex-col items-start gap-[16px] desk:mt-[calc(104*var(--u))] uk:desk:mt-[calc(134*var(--u))] desk:flex-row desk:items-center desk:justify-end desk:gap-[calc(48*var(--u))]">
      <p class="text-[clamp(16px,4.2vw,20px)] leading-[1.35] font-bold text-black [--d:.6s] motion-safe:animate-blur-in desk:text-[max(14px,calc(20*var(--u)))] desk:leading-[1.3]">
        {hero.note[0]}
        <br />
        {hero.note[1]}
      </p>
      <Button
        href="#pricing"
        class="w-full [--d:.8s] motion-safe:animate-rise-in tab:w-auto"
      >
        {hero.cta}
        <span
          aria-hidden="true"
          class="inline-flex transition-transform duration-200 ease-mv group-hover/btn:translate-x-[5px]"
        >
          <Arrow />
        </span>
      </Button>
    </div>
  </Container>
</section>

<div class="overflow-hidden border-y border-line bg-snow py-[calc(20*var(--u))]">
  <ul
    aria-label={trust.label}
    class="flex w-max items-center marquee-always animate-marquee hover:[animation-play-state:paused]"
  >
    {[false, true].map((copy) =>
      trust.items.map((item) => (
        <li
          aria-hidden={copy ? 'true' : undefined}
          class="inline-flex items-center gap-[calc(16*var(--u))] pr-[calc(58*var(--u))] text-[max(15px,calc(20*var(--u)))] font-medium whitespace-nowrap text-black"
        >
          <i aria-hidden="true" class="size-[6px] bg-amber-500" />
          {item}
        </li>
      )),
    )}
  </ul>
</div>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // «Not just a new website» types itself out line by line once the entrance has played.
  const typed = document.querySelector<HTMLElement>('[data-type]');
  if (typed && !reduce) {
    const lines = [...typed.querySelectorAll('span')];
    const texts = lines.map((l) => l.textContent ?? '');
    typed.parentElement!.style.minHeight = `${typed.parentElement!.offsetHeight}px`;
    lines.forEach((l) => (l.textContent = ''));
    let li = 0;
    let ci = 0;
    const tick = () => {
      if (li >= lines.length) return;
      lines[li].textContent = texts[li].slice(0, ++ci);
      if (ci >= texts[li].length) {
        li++;
        ci = 0;
        setTimeout(tick, 140);
      } else setTimeout(tick, 28);
    };
    setTimeout(tick, 1100);
  }

  // Thin amber streaks run along random grid lines, at most two at a time.
  const box = document.querySelector<HTMLElement>('[data-streaks]');
  if (box && !reduce) {
    const spawn = () => {
      if (document.hidden || box.childElementCount >= 2) return;
      const c = Math.min(1, innerWidth / 1920) * 80; // grid cell, as in bg-grid
      const cols = Math.floor(box.clientWidth / c);
      const rows = Math.floor(box.clientHeight / c);
      const pick = (n: number) =>
        Math.floor(Math.random() * Math.max(1, n)) * c;
      const el = document.createElement('i');
      const t = `${1.2 + Math.random() * 0.8}s`;
      if (Math.random() < 0.6) {
        el.className = 'streak h-px w-[calc(200*var(--u))]';
        el.style.cssText = `top:${pick(rows)}px;left:${pick(cols - 4)}px;--dx:${c * 4}px;--t:${t}`;
      } else {
        el.className = 'streak w-px h-[calc(180*var(--u))] [--dir:180deg]';
        el.style.cssText = `left:${pick(cols)}px;top:${pick(rows - 3)}px;--dy:${c * 3}px;--t:${t}`;
      }
      el.addEventListener('animationend', () => el.remove());
      box.appendChild(el);
    };
    const loop = () => {
      spawn();
      setTimeout(loop, 1500 + Math.random() * 2000);
    };
    loop();
  }
</script>
