---
// Process ("How we do it"): a header card with the mascot, then the three steps.
// Spacing converts Figma's ink positions to CSS boxes with the font metrics (see Pain.astro).
// Mobile: the mascot stands on the header card's top edge and pokes 21px into the pain
// section above. lg: it sits in the card's bottom-left corner, overflowing the top, with
// the left of the sweater cropped as in Figma. `flow-root` on the card stops the mascot's
// negative margin collapsing through it (which would drag the white card up too).
// The desktop steps are equal columns (Figma's are uneven; same call as the pain cards).
import { Image } from 'astro:assets';
import Card from '../ui/Card.astro';
import Heading from '../ui/Heading.astro';
import Section from '../ui/Section.astro';
import mascot from '../../assets/images/mascot-cutout.png';
import { getLang, t } from '../../i18n/utils';

const copy = t(getLang(Astro.url)).process;
---

<Section
  id="how-we-work"
  class="pt-[161px] pb-[77px] lg:pt-[130px] lg:pb-[113px]"
>
  <Card class="relative flow-root px-5 pt-0 pb-[16px] text-center lg:min-h-[276px] lg:pt-[36px] lg:pr-6.5 lg:pb-[68px] lg:pl-[294px] lg:text-left">
    <!-- TODO(asset): 1x cut-out from the Webflow build (273x322). Swap for a 2x transparent
         export of Figma 1:512; then the lg crop below can go if the export is pre-cropped. -->
    <div class="mx-auto -mt-[182px] w-fit lg:absolute lg:bottom-0 lg:left-0 lg:m-0 lg:h-[316px] lg:w-[232px] lg:overflow-hidden">
      <Image
        src={mascot}
        alt=""
        class="h-[182px] w-auto lg:absolute lg:-top-[6px] lg:-right-[14px] lg:h-[322px] lg:max-w-none"
      />
    </div>

    <Heading class="mt-[5px] lg:mt-0">{copy.title}</Heading>
    <p class="mx-auto mt-[26px] max-w-[205px] text-[14px] lg:mx-0 lg:mt-[31px] lg:max-w-[252px] lg:text-body">
      {copy.intro}
    </p>
    <!-- Decorative section tag, desktop only (not in the mobile frame). -->
    <p
      aria-hidden="true"
      class="absolute top-[44px] right-[32px] max-lg:hidden"
    >
      {copy.label}
    </p>
  </Card>

  <ol class="mt-[19px] grid gap-[19px] text-center lg:mt-[13px] lg:grid-cols-3 lg:gap-x-12 lg:rounded-card lg:bg-white lg:px-[37px] lg:pt-[18px] lg:pb-[53px] lg:text-left">
    {copy.steps.map(({ title, text }, i) => (
      <li class="rounded-card bg-white px-5 pt-[8.5px] pb-[20px] lg:rounded-none lg:bg-transparent lg:p-0">
        <p class="text-[16px] lg:text-body" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </p>
        <h3 class="mx-auto mt-[30px] max-w-[250px] text-card font-bold lg:mx-0 lg:mt-[52px] lg:max-w-none">
          {title[0]}
          <br class="max-lg:hidden" /> {title[1]}
        </h3>
        <p class="mt-[38px] lg:mt-[70px] lg:text-lead lg:leading-[30px]">
          {text}
        </p>
      </li>
    ))}
  </ol>
</Section>
