---
// Process (design v3.15, section 03): head + three full-width step rows on the warm grid.
// Each row: big figure (3fr), title + text (5fr), detail (4fr) behind an amber line. Below 1200px
// they stack and the line runs across the top of the detail. Rows slide in with data-ri; the line
// draws and the detail fades in as each lands (.flow-side in global.css). The design starts all
// three when the first is seen; here each starts as it enters the view (same reveal as the cards).
import Container from '../ui/Container.astro';
import SectionHead from '../ui/SectionHead.astro';
import { getLang, t } from '../../i18n/utils';

const { process: p } = t(getLang(Astro.url));
---

<section
  id="how-we-work"
  class="bg-warm-100 bg-grid py-[max(80px,calc(140*var(--u)))]"
>
  <Container wide>
    <SectionHead label={p.label} title={p.title} lead={p.intro} />
    <ol class="grid gap-[max(12px,calc(16*var(--u)))]">
      {p.steps.map((s) => (
        <li
          data-ri
          class="grid items-start gap-[14px] rounded-[16px] border border-line bg-snow px-[max(24px,calc(40*var(--u)))] py-[28px] desk:grid-cols-[minmax(0,3fr)_minmax(0,5fr)_minmax(0,4fr)] desk:gap-g desk:py-[max(28px,calc(48*var(--u)))]"
        >
          <p class="flex flex-wrap items-baseline gap-[12px] font-head leading-none font-semibold tracking-[-0.02em] text-ink">
            <b class="text-[max(56px,calc(96*var(--u)))] leading-[0.85] font-semibold">
              {s.fig[0]}
            </b>
            <span class="text-[max(20px,calc(28*var(--u)))] tracking-[-0.01em]">
              {s.fig[1]}
            </span>
          </p>
          <div class="flex flex-col gap-[10px]">
            <h3 class="font-head text-h3 leading-[1.05] font-bold tracking-[-0.005em] text-ink">
              {s.title}
            </h3>
            <p class="text-body leading-[1.5] text-ink-2">{s.text}</p>
          </div>
          <div class="flow-side relative self-stretch pt-[16px] before:absolute before:top-0 before:left-0 before:h-[2px] before:w-full before:bg-amber-500 desk:pt-0 desk:pl-[max(16px,calc(24*var(--u)))] desk:before:h-full desk:before:w-[2px]">
            <p class="flow-more text-body leading-[1.5] text-ink">{s.more}</p>
          </div>
        </li>
      ))}
    </ol>
  </Container>
</section>
