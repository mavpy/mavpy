# Lead delivery (contact form). Copy to .env and fill in; set the same vars on the host.
# Telegram: token from @BotFather; chat id of the group the bot is in (negative number).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Visitor confirmation: bot username (no @) for the t.me link, and a random secret for the webhook
# (e.g. `openssl rand -hex 32`). Register the webhook once per deploy URL:
# curl https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook -d url=https://<site>/api/telegram \
#   -d secret_token=$TELEGRAM_WEBHOOK_SECRET -d allowed_updates='["message","callback_query"]'
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Airtable: personal access token (data.records:write on the base), base id (app...), table name.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=Leads
# Auto-reply to the person who submitted the form (Resend). No key = no auto-reply.
# Without a verified domain Resend only delivers to your own account address; MAIL_FROM then
# stays empty (falls back to onboarding@resend.dev). Later: MAIL_FROM="MAVPY <hello@your-domain>".
RESEND_API_KEY=
MAIL_FROM=
# Google Analytics 4 measurement id (G-XXXXXXX). Empty = analytics off (no banner, no gtag).
# Set = a cookie banner; gtag loads only after the visitor accepts (Consent Mode v2, defaults denied).
PUBLIC_GA_ID=
